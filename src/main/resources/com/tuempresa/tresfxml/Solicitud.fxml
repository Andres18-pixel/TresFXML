<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane hgap="10" vgap="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.tresfxml.SolicitudController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <fx:define>
        <ToggleGroup fx:id="tgPrioridad" />
    </fx:define>

    <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <TextField fx:id="txtCliente" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2" />

    <Label text="Correo Cliente:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <TextField fx:id="txtCorreoCliente" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2" />

    <Label text="Tipo Cliente:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <TextField fx:id="txtTipoCliente" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2" />

    <Label text="Asunto:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
    <TextField fx:id="txtAsunto" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2" />

    <Label text="Tipo Servicio:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
    <ComboBox fx:id="cbTipoServicio" prefWidth="200" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2" />

    <Label text="Prioridad:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
    <HBox spacing="15" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="2">
        <RadioButton fx:id="rbBaja" text="Baja" toggleGroup="$tgPrioridad" />
        <RadioButton fx:id="rbMedia" text="Media" toggleGroup="$tgPrioridad" />
        <RadioButton fx:id="rbAlta" text="Alta" toggleGroup="$tgPrioridad" />
    </HBox>

    <Label text="Descripción:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
    <TextArea fx:id="txtDescripcion" prefRowCount="3" GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="2" />

    <Label text="Archivo Adjunto:" GridPane.rowIndex="7" GridPane.columnIndex="0" />
    <TextField fx:id="txtAdjunto" editable="false" GridPane.rowIndex="7" GridPane.columnIndex="1" />
    <Button text="Buscar..." onAction="#seleccionarAdjunto" GridPane.rowIndex="7" GridPane.columnIndex="2" />

    <Label text="Carpeta Evidencias:" GridPane.rowIndex="8" GridPane.columnIndex="0" />
    <TextField fx:id="txtEvidencias" editable="false" GridPane.rowIndex="8" GridPane.columnIndex="1" />
    <Button text="Buscar..." onAction="#seleccionarEvidencias" GridPane.rowIndex="8" GridPane.columnIndex="2" />

    <HBox spacing="10" alignment="CENTER" GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="3">
        <padding><Insets top="15" /></padding>
        <Button text="Guardar" onAction="#guardar" />
        <Button text="Crear Solicitud" onAction="#crearSolicitud" />
        <Button text="Limpiar" onAction="#limpiar" />
        <Button text="Cerrar" onAction="#cerrar" />
    </HBox>
</GridPane>